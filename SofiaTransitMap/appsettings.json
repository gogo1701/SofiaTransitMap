{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Transit": "Data Source=App_Data/transit.db"
  },
  "Gtfs": {
    "StaticUrl": "https://gtfs.sofiatraffic.bg/api/v1/static",
    "StaticRefreshHours": 12
  },
  "Realtime": {
    "Enabled": true,
    "PollSeconds": 20,
    "SnapshotSeconds": 120,
    "DelayedThresholdSeconds": 180,
    "SevereThresholdSeconds": 600,
    "RetentionDays": 90
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "PhotonUrl": "https://photon.komoot.io/",
    "GoogleApiKey": "",
    "UserAgent": "SofiaTransitMap/1.0 (https://github.com/gogo1701/SofiaTransitMap)"
  }
}
